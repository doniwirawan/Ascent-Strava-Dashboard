<?xml version="1.0" encoding="utf-8"?>
<!-- 4x4: the medium layout plus the latest activity name. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/brand"
            android:textColor="@color/orange"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.14" />

        <TextView
            android:id="@+id/tvSync"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/dim"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Recovery and Strain rings, mirroring the web dashboard. RemoteViews has
         no drawing primitives, so each ring is a bitmap rendered in Kotlin.
         Tapping a ring opens the native Recovery screen. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <ImageView
            android:id="@+id/ivRecovery"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/recovery_desc" />

        <ImageView
            android:id="@+id/ivStrain"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/strain_desc" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="true">

                <TextView
                    android:id="@+id/tvBig"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tvBigUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="@string/km"
                    android:textColor="@color/muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBigLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:text="@string/last_7_days"
                android:textColor="@color/dim"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvTotals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:textColor="@color/dim"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvLast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/dim"
        android:textSize="10sp" />

    <ImageView
        android:id="@+id/ivChart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:minHeight="18dp"
        android:scaleType="fitXY"
        android:contentDescription="@string/chart_desc" />

</LinearLayout>
