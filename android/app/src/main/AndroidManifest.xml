<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- self-update: hand the downloaded APK to Android's installer (Updater.kt) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Health Connect: read the sleep and steps your watch app writes there -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <!-- read further back than 30 days (the first sync backfills a year) -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <activity
            android:name=".AppActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Health Connect asks the app why it wants the data (Android 13 and older) -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- The same rationale screen for Health Connect on Android 14+ -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".AppActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- The full web dashboard, opened from the native screens. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:label="@string/app_name" />

        <activity
            android:name=".ChatsActivity"
            android:exported="false"
            android:label="AI Coach" />

        <activity
            android:name=".RoutesActivity"
            android:exported="false"
            android:label="All routes" />

        <activity
            android:name=".RideActivity"
            android:exported="false"
            android:label="Activity" />

        <!-- The widget's configure screen: shown when the widget is placed, and
             again on long-press thanks to widgetFeatures="reconfigurable". That
             is the only route to it, since MainActivity runs without a title bar. -->
        <activity
            android:name=".RecoveryActivity"
            android:exported="false"
            android:label="Recovery" />

        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:label="Widget settings">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Refresh intents target this receiver explicitly, so only the system
             APPWIDGET_UPDATE broadcast needs a filter. -->
        <receiver
            android:name=".AscentWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ascent_widget_info" />
        </receiver>

        <receiver
            android:name=".AscentWidgetSmall"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ascent_widget_small_info" />
        </receiver>

        <receiver
            android:name=".AscentWidgetLarge"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ascent_widget_large_info" />
        </receiver>

    </application>

</manifest>
