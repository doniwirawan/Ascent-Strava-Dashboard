{
  "outputDirectory": "dist",
  "buildCommand": "npm install && node build.js",
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [{ "type": "host", "value": "ascent-analytics.vercel.app" }],
      "destination": "https://ascent-analytics.doniwirawan.xyz/:path",
      "permanent": false
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [{ "type": "host", "value": "stravadashboard.vercel.app" }],
      "destination": "https://ascent-analytics.doniwirawan.xyz/:path",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/api/v1", "destination": "/api/stats?v1=" },
    { "source": "/api/v1/", "destination": "/api/stats?v1=" },
    { "source": "/api/v1/:path*", "destination": "/api/stats?v1=:path*" },
    { "source": "/callback", "destination": "/callback.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/guide", "destination": "/guide.html" }
  ]
}
